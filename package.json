{
  "name": "@dsh-external/dsh-ui-progress",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "DSH Web UI 任务进度插件：report_progress 工具动画卡片（左侧加载圈运行中旋转）+ 输入框停靠区常驻会话进度条，零核心改动。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dshClient": {
    "inject": [
      "@deepseek-ai/dsh-client-locale",
      "@deepseek-ai/dsh-client-runtime",
      "@deepseek-ai/dsh-client-ui-conversation"
    ],
    "platform": "web"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-tool-todo": "*",
    "@deepseek-ai/dsh-tools": "*",
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": "link:../.dsh/source/current/packages/client/locale",
    "@deepseek-ai/dsh-client-runtime": "link:../.dsh/source/current/packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../.dsh/source/current/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../.dsh/source/current/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-slots": "link:../.dsh/source/current/packages/client/ui-slots",
    "@deepseek-ai/dsh-invariants": "link:../.dsh/source/current/packages/support/invariants",
    "@deepseek-ai/dsh-tool-todo": "link:../.dsh/source/current/packages/todo/tool-todo",
    "@deepseek-ai/dsh-tools": "link:../.dsh/source/current/packages/core/tools",
    "@types/react": "~18.3.1",
    "clsx": "^2.1.1",
    "cordis": "link:../.dsh/source/current/vendor/cordis",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  },
  "license": "BSD-3-Clause"
}
